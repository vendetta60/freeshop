# =============================================================================
#  FreeShop - environment template
#  Copy to .env and fill in. NEVER commit .env (see .gitignore).
#  Frontend vars MUST be duplicated into frontend/.env.local (VITE_* only).
# =============================================================================

# --- Core / Brand (see plan.md 3.0 - these change on rebrand, nothing else does)
ENV=development                 # development | production
APP_NAME=FreeShop               # emails, OTP templates, page-title suffix
REQUEST_PREFIX=SR               # request_no format: <PREFIX>-YYYY-NNNN
API_BASE_URL=http://localhost:8000      # docker prod: http://localhost
FRONTEND_URL=http://localhost:5173      # docker prod: http://localhost
CORS_ORIGINS=http://localhost:5173      # comma-separated. docker prod: http://localhost
                                        # Behind Caddy the SPA and API are same-origin, so
                                        # CORS is barely exercised in prod. Keep it strict
                                        # anyway - a permissive prod CORS is a review finding.

# --- Security ---
# Generate with:  openssl rand -hex 32
# The app REFUSES TO BOOT with ENV=production and this placeholder value.
JWT_SECRET=change-me-min-32-bytes-use-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/freeshop.db

# --- Google OAuth ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Keep the consent screen in TESTING mode; add your own Gmail as a test user.
# Authorized JavaScript origins: http://localhost:5173  and  http://localhost
# Leave blank for now: the API starts fine and /auth/google returns a clear
# GOOGLE_NOT_CONFIGURED error instead of crashing. See plan.md 18/W2.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phone auth / OTP (plan.md 9.11, 18/W1) ---
# Local-demo escape hatch: permits OTP_CHANNEL=console under ENV=production.

# Send limits (plan.md 9.4). These ARE the specified values; raise them only
# on a shared demo machine, where one seeded admin number is passed around a
# room. Startup warns if they exceed the defaults under ENV=production.
OTP_MAX_SENDS_PER_PHONE=3
OTP_SEND_WINDOW_MINUTES=15
OTP_MAX_SENDS_PER_IP=10
OTP_IP_WINDOW_MINUTES=60
# Codes then appear in the container log and at /api/v1/dev/otp-inbox.
# NEVER enable on anything reachable from the internet.
DEMO_MODE=true

AUTH_PHONE_ENABLED=true         # master switch. false => Google-only auth, no OTP traffic.
                                # true + console channel is the decided demo setup.
OTP_CHANNEL=console             # console | telegram | email | sms
                                # 'console' is REFUSED at startup when ENV=production
OTP_TTL_SECONDS=300
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                  # Gmail app password, not the account password
SMTP_FROM=

# --- Uploads ---
UPLOAD_DIR=./static/uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_PRODUCT=8

# --- Seed (plan.md 8.1) ---
ADMIN_EMAIL=
ADMIN_PHONE=

# =============================================================================
#  Frontend - VITE_ prefixed vars are PUBLIC and end up in the browser bundle.
#  NEVER put a secret here.
# =============================================================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_DEFAULT_LANG=az
VITE_AUTH_PHONE_ENABLED=true    # MUST mirror AUTH_PHONE_ENABLED; hides the phone tab in the UI
