{
  "name": "freeshop-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:assets": "node scripts/brand-assets.mjs",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.ts",
    "demo:images": "node scripts/demo-images.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:fetch": "node scripts/demo-fetch.mjs",
    "smoke": "node scripts/smoke.mjs",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "dev:lan": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.1.0",
    "cmdk": "^1.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
